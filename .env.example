# Default report: disaggregated futures-only COT historical compressed report.
# Supported values: disaggregated_futures_only, financial_futures_only, legacy_futures_only
COT_REPORT_TYPE=disaggregated_futures_only

# Leave blank to use current year. Set for repeatable historical runs, e.g. 2025.
COT_YEAR=

# HTTP request timeout in seconds.
REQUEST_TIMEOUT_SECONDS=30

# Optional: official FRED Web Services key (https://fred.stlouisfed.org/docs/api/api_key.html).
# When set, macro downloads use the API; otherwise the public graph CSV endpoint is used.
FRED_API_KEY=

# Live market environment feed (optional — omit keys to leave dashboard sections NOT WIRED).
# ECONOMIC_CALENDAR_PROVIDER=finnhub|trading_economics|both  # default: auto from keys below
# FINNHUB_API_KEY=          # economic calendar + filtered headlines
# TRADINGECONOMICS_API_KEY= or TRADING_ECONOMICS_API_KEY=  # economic calendar (preferred)
# OPENWEATHER_API_KEY=        # weather summaries for NG, grains, coffee, cocoa
# HPTL_SKIP_LIVE_FEEDS=1     # cache-only macro mode (no FRED HTTP) during the COT/confluence rebuild

# --- Stage B: resilient macro data layer (FRED) ---
# HPTL_MACRO_CACHE=1            # 1 = persistent cache + fallback (default); 0 = legacy direct fetch (kill switch)
# HPTL_MACRO_CACHE_DIR=         # override macro series cache dir (default: data/macro_cache)
# HPTL_MACRO_FETCH_RETRIES=4    # live FRED fetch attempts before cache fallback
# HPTL_MACRO_FETCH_TIMEOUT=45   # per-attempt FRED timeout (seconds)
# Freshness bands (days since last successful refresh): 0-7 Live, 8-30 Cached, 31-90 Stale, >90 Warning.
# Refresh the macro layer on its own schedule: python -m hptl.macro.run_macro_refresh

# --- Live price APIs (required for price coverage audit) ---
# OANDA_API_KEY=              # personal access token (Bearer) — never commit
# OANDA_ACCOUNT_ID=           # optional; default = first account from API
# OANDA_ENVIRONMENT=practice  # practice | live  (or set OANDA_API_URL= full base URL)
# ALPHA_VANTAGE_API_KEY=      # Alpha Vantage — never commit
# Run: python -m hptl.prices.run_price_coverage_audit
# ALPHA_VANTAGE_PRICE_DELAY_SEC=12   # pause between AV instrument fetches (rate limits)
# Run price store: python -m hptl.prices.run_price_refresh
