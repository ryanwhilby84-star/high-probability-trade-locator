{
  "version": 1,
  "description": "Instrument-scoped catalyst keywords, related markets, and macro sensitivities. Used only for tagging and routing real adapter outputs — not for inventing prices or positions.",
  "global": {
    "title_sentiment_lexicon": {
      "positive": [
        "smaller than expected",
        "better than expected",
        "surplus build",
        "bearish for prices",
        "cooler than normal"
      ],
      "negative": [
        "larger than expected",
        "miss estimates",
        "draw",
        "shortfall",
        "freeze-off",
        "outage",
        "sanctions",
        "embargo"
      ]
    }
  },
  "instruments": {
    "NASDAQ / NQ": {
