        "rates_fed": ["FOMC", "Fed", "dot plot", "Powell", "rate cut", "rate hike"],
        "tech_earnings": ["Magnificent 7", "NVIDIA", "guidance", "AI capex", "semiconductor"]
      },
      "related_markets": ["S&P 500 / ES", "Gold"],
      "macro_sensitivities": ["real_rates", "liquidity", "usd_funding", "growth_expectations"]
    },
    "S&P 500 / ES": {
